{
  "name": "braz-via",
  "version": "1.0.0",
  "private": true,
  "description": "BRAZVIA API — NestJS + Sequelize + AWS Lambda (SAM)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "sequelize-cli db:seed:all",
    "sam:build": "npm run build && sam build --config-env production",
    "sam:local": "sam local start-api --config-env production --warm-containers EAGER",
    "sam:deploy": "sam deploy --config-env production --guided"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.804.0",
    "@aws-sdk/client-s3": "^3.1062.0",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@vendia/serverless-express": "^4.12.6",
    "aws-jwt-verify": "^4.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.4.7",
    "ioredis": "^5.11.1",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sequelize": "^6.37.7",
    "sharp": "^0.35.4",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@types/aws-lambda": "^8.10.152",
    "@types/express": "^5.0.3",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.17.0",
    "@types/uuid": "^10.0.0",
    "sequelize-cli": "^6.6.3",
    "typescript": "^5.9.2"
  }
}
