NODE_ENV=development
PORT=3333
PATH_PREFIX=api
APP_URL=http://localhost:3333

DB_HOST=localhost
DB_PORT=5434
DB_USER=brazvia
DB_PASSWORD=brazvia
DB_NAME=brazvia

# Cognito — sem pool/client o back usa mock automaticamente
COGNITO_REGION=sa-east-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_ADMIN_GROUP=admin

# S3 — vazio = upload local em /uploads
S3_BUCKET=
S3_REGION=sa-east-1
S3_PUBLIC_BASE_URL=
S3_PROPERTIES_PREFIX=properties
S3_MAX_UPLOAD_BYTES=5242880

CORS_ORIGIN=http://localhost:5174,http://127.0.0.1:5174
